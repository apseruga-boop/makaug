{
  "name": "makaug-platform",
  "version": "1.0.0",
  "private": true,
  "description": "makaug property platform backend and static frontend",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "dev:whatsapp-web": "node scripts/whatsapp-web-copilot.js",
    "dev:whatsapp-agent": "node scripts/whatsapp-web-agent.js",
    "dev:bot": "tsx watch src/server.ts",
    "start:bot": "node dist/server.js",
    "build:css": "BROWSERSLIST_IGNORE_OLD_DATA=true tailwindcss -c tailwind.config.cjs -i assets/tailwind.input.css -o assets/tailwind.css --minify",
    "build:shared-homepage": "node scripts/build-shared-homepage-core.js",
    "build:bot": "npm run build:css && tsc -p tsconfig.json",
    "typecheck:bot": "tsc -p tsconfig.json --noEmit",
    "test:bot": "vitest run",
    "test:off-plan": "node --test tests/off-plan-service.test.js tests/off-plan-contract.test.js tests/off-plan-route-auth.test.js tests/off-plan-brochure.test.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "admin:create-super": "node scripts/create-super-admin.js",
    "ai:export-training": "node scripts/export-ai-training-data.js",
    "ai:export-foundation": "node scripts/export-llm-foundation-data.js",
    "ai:run-agents": "node scripts/run-ai-agents.js",
    "ai:ceo-morning-report": "node scripts/send-ai-ceo-morning-report.js",
    "ai:outlook-email-agent": "node scripts/run-outlook-ai-email-agent.js",
    "ai:verify-whatsapp": "node scripts/verify-whatsapp-ai-provider.js",
    "test:whatsapp-conversations": "node scripts/whatsapp-conversation-self-test.js",
    "test:whatsapp-conversations:live": "WHATSAPP_SELF_TEST_BASE_URL=https://makaug.com node scripts/whatsapp-conversation-self-test.js",
    "test:ai-ceo-phone": "node scripts/test-ai-ceo-phone-control.js",
    "qa:postman": "bash scripts/run-postman-qa.sh",
    "qa:postman:render": "BASE_URL=https://makaug.onrender.com bash scripts/run-postman-qa.sh",
    "qa:create-listings": "node scripts/create-qa-listings.js",
    "qa:seed-whatsapp-inventory": "node scripts/seed-whatsapp-test-inventory.js",
    "inventory:seed-bakaima": "node scripts/seed-bakaima-authorised-land-listings.js",
    "inventory:seed-carnelian": "node scripts/seed-carnelian-authorised-listings.js",
    "inventory:seed-social-search": "node scripts/seed-social-search-authorised-listings.js",
    "inventory:seed-source-registry": "node scripts/seed-property-source-registry.js",
    "marketplace:seed-google": "node scripts/seed-marketplace-google-places.js",
    "inventory:daily-source-sweep": "node scripts/run-daily-found-online-source-sweep.js",
    "inventory:continuous-monitor": "node scripts/run-continuous-social-monitor.js",
    "inventory:import-source-posts": "node scripts/import-found-online-source-posts.js",
    "inventory:sweep-social-platforms": "node scripts/sweep-social-platform-posts.js",
    "inventory:youtube-backfill": "node scripts/backfill-youtube-harvest.js",
    "inventory:tiktok-autopublish": "node scripts/run-tiktok-autopublish-agent.js",
    "inventory:prepare-video-stills": "node scripts/prepare-found-online-video-stills.js",
    "inventory:import-found-online-images": "node scripts/import-found-online-images.js",
    "ads:daily-report": "node scripts/send-advertising-daily-reports.js",
    "data:backup": "node scripts/run-production-data-backup.js",
    "data:backfill-whatsapp-video-stills": "node scripts/backfill-whatsapp-video-stills.js",
    "cloud:readiness": "node scripts/check-cloud-readiness.js",
    "cloud:verify-storage": "node scripts/verify-cloud-storage.js",
    "locations:build-uganda": "node scripts/build-uganda-location-gazetteer.js",
    "locations:probe-uganda": "node scripts/probe-uganda-location-coverage.js",
    "locations:sweep-uganda": "node scripts/location-coverage-sweep.mjs coverage-results.csv",
    "locations:build-south-africa": "node scripts/build-south-africa-location-gazetteer.js",
    "inventory:seed-south-africa-sources": "node scripts/seed-south-africa-source-registry.js",
    "brand:icons-south-africa": "node scripts/generate-seshaikhaya-icons.js",
    "probe:public-routes": "node scripts/probe-public-routes.js",
    "probe:public-routes:browser": "node scripts/probe-public-routes-browser.js",
    "probe:click-actions": "node scripts/probe-click-actions.js",
    "probe:backend-connections": "node scripts/probe-backend-connections.js",
    "probe:route-transitions": "node scripts/probe-route-transitions.js",
    "probe:performance": "node scripts/probe-performance.js",
    "parity:country-homepages": "node scripts/check-country-homepage-parity.js",
    "check": "node --check server.js",
    "test:go-live-p0": "node tests/go-live-p0.test.js",
    "test:seo-ssr": "node tests/seo-ssr-crawlability.test.js",
    "test:king-harvester-p0": "node tests/king-harvester-route-contract.test.js",
    "test:social-coverage-30k": "node --test tests/social-coverage-30k.test.js",
    "test:shared-core-phase1": "node tests/shared-core-phase1.test.js",
    "test:south-africa": "COUNTRY_CODE=ZA node tests/south-africa-tenant.test.js && COUNTRY_CODE=ZA node tests/south-africa-location-audit.test.js && COUNTRY_CODE=ZA node tests/south-africa-intake-integrity.test.js && COUNTRY_CODE=ZA node tests/south-africa-whatsapp-contract.test.js && COUNTRY_CODE=ZA WHATSAPP_DELIVERY_MODE=test node tests/south-africa-whatsapp-test-transport.test.js && node tests/south-africa-migration-isolation.test.js",
    "smoke": "bash scripts/smoke-test.sh",
    "prelaunch": "bash scripts/prelaunch-check.sh"
  },
  "engines": {
    "node": "20.x"
  },
  "files": [
    "packages/shared-country-core"
  ],
  "exports": {
    "./shared-country-core": "./packages/shared-country-core/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "openai": "^4.104.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "playwright-core": "^1.59.1",
    "sharp": "^0.35.3",
    "twilio": "^5.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/helmet": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
