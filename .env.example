NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://makaug.com
# Optional SEO rendering controls. Defaults: 180000 ms cache, 500-entry LRU,
# minimum 3 live listings.
PUBLIC_SEO_LISTING_CACHE_TTL_MS=180000
PUBLIC_SEO_LISTING_CACHE_MAX_ENTRIES=500
PUBLIC_SEO_FACET_MIN_LISTINGS=3
APP_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/makaug
DB_SSL=false
USE_MOCK_REPOSITORIES=false

# Security / auth (existing backend)
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=7d
STAFF_JWT_EXPIRES_IN=30d
ADMIN_REVIEW_QUEUE_QUERY_TIMEOUT_MS=4000
USD_TO_UGX_RATE=3800
OTP_EXPIRES_MINUTES=10
ADMIN_API_KEY=change-me-admin-key
SUPER_ADMIN_KEY=change-me-super-admin-key

# One-time super admin bootstrap. Set these only in the secure deployment
# environment, run `npm run admin:create-super`, then rotate/remove
# SUPER_ADMIN_INITIAL_PASSWORD after the owner has changed password.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_INITIAL_PASSWORD=change-me-long-one-time-password
SUPER_ADMIN_PHONE=
# Optional social sign-in. Add the matching callback URL in each provider console:
# Google: https://makaug.com/api/auth/oauth/google/callback
# Facebook: https://makaug.com/api/auth/oauth/facebook/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# AI ingest site keys are generated per-site using:
# POST /api/ai-core/sites/:siteCode/rotate-key (requires x-api-key: ADMIN_API_KEY)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Public inventory response cache. Defaults to 60000ms when unset.
# PUBLIC_OPPORTUNITY_SUMMARY_CACHE_TTL_MS is kept as a compatible alias.
PUBLIC_PROPERTIES_CACHE_TTL_MS=60000
PUBLIC_OPPORTUNITY_SUMMARY_CACHE_TTL_MS=

# Social/property discovery APIs for the found-online source sweeps.
# YouTube and X are wired for direct API discovery. Meta/TikTok credentials are
# tracked for approved-platform readiness; broad Facebook/Instagram/TikTok feeds
# still require exact public post/video URLs or approved API adapters before import.
# Provider-driven jobs and public submissions stay disabled during rollout.
# Authenticated King/staff exact-link imports remain available for Dave's verification.
HARVEST_AUTOMATION_ENABLED=false
HARVEST_PUBLIC_SUBMISSIONS_ENABLED=false
SOCIAL_SWEEP_MAX_SOURCE_TARGET=60000
YOUTUBE_API_KEY=
GOOGLE_YOUTUBE_API_KEY=
GOOGLE_API_KEY=
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
X_API_BEARER_TOKEN=
META_GRAPH_ACCESS_TOKEN=
FACEBOOK_GRAPH_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=
FACEBOOK_PAGE_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_IDS=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_RESEARCH_API_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DISPLAY_MODE=sandbox
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
# Encrypts stored OAuth access and refresh tokens. Use a separate random secret in production.
TIKTOK_TOKEN_ENCRYPTION_KEY=

# X source drip crawler. Scheduler is armed by the server but stays paused until
# an admin starts it from King/staff controls.
X_SOURCE_DRIP_SCHEDULER_ENABLED=true
X_SOURCE_DRIP_BASE_INTERVAL_MINUTES=2
X_SOURCE_DRIP_BATCH_SIZE=20
X_SOURCE_DRIP_MAX_RESULTS=10
X_SOURCE_DRIP_SEARCH_MODE=recent
X_SOURCE_DRIP_PUBLISHED_AFTER=2026-01-01T00:00:00.000Z
X_SOURCE_DRIP_MONTHLY_READ_CAP=10000

# Daily public featured-listing rotation. The scheduler selects two clean,
# approved listings per public category after 07:00 Kampala time.
FEATURED_ROTATION_SCHEDULER_ENABLED=true
FEATURED_ROTATION_TIMEZONE=Africa/Kampala
FEATURED_ROTATION_HOUR=7
FEATURED_ROTATION_POLL_MS=60000

# Monetization spine / hosted payments.
# Keep paid features disabled until Arthur approves public launch.
UGANDA_PAYMENT_PROVIDER=flutterwave
PAYMENT_PROVIDER=flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_LINK_BASE_URL=
MAKAUG_LISTING_BOOSTS_ENABLED=false
MAKAUG_AGENT_PRO_ENABLED=false
MAKAUG_FEATURED_LENDERS_ENABLED=false

# WhatsApp Business Cloud API
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=makaug-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Delivery mode: provider | web_bridge | auto
# For the live WhatsApp Web bridge, set WHATSAPP_DELIVERY_MODE=web_bridge
# and keep WHATSAPP_WEB_COPILOT_BASE_URL/PUBLIC_BASE_URL pointed at https://makaug.com.
WHATSAPP_DELIVERY_MODE=auto
# Local WhatsApp Web copilot bridge
WHATSAPP_WEB_BRIDGE_ENABLED=false
WHATSAPP_WEB_BRIDGE_TOKEN=change-me-whatsapp-web-bridge-token
WHATSAPP_WEB_BRIDGE_CLAIM_SECONDS=45
WHATSAPP_WEB_BRIDGE_RETRY_SECONDS=30
WHATSAPP_WEB_COPILOT_BASE_URL=https://makaug.com
WHATSAPP_WEB_COPILOT_CLIENT_ID=makaug-whatsapp-web
WHATSAPP_WEB_COPILOT_OPERATOR_NAME=
WHATSAPP_WEB_COPILOT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
WHATSAPP_WEB_COPILOT_PROFILE_DIR=.whatsapp-web-copilot-profile
WHATSAPP_WEB_COPILOT_POLL_MS=100
WHATSAPP_WEB_COPILOT_HEARTBEAT_MS=30000
WHATSAPP_INTENT_AI_MODE=fast
WHATSAPP_LANGUAGE_AI_MODE=fast
WHATSAPP_NATURAL_SEARCH_AI_MODE=fast
WHATSAPP_REPLY_AI_MODE=fast
WHATSAPP_FAST_ASSISTANT_TIMEOUT_MS=900
WHATSAPP_NATURAL_SEARCH_AI_TIMEOUT_MS=900

# Legacy OpenAI fallback vars (optional).
# Keep empty when using only your own OpenAI-compatible/self-hosted endpoint.
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_CAMPAIGN_MODEL=gpt-4.1-mini
OPENAI_LISTING_MODEL=gpt-4.1-mini
OPENAI_REPLY_MODEL=gpt-4.1-mini

# LLM provider abstraction (for your own model infra)
# LLM_PROVIDER: openai_compat | openai | none
LLM_PROVIDER=openai_compat
# Example for self-hosted OpenAI-compatible endpoint:
# LLM_API_BASE_URL=http://localhost:8000/v1
LLM_API_BASE_URL=
# Optional. If your model server requires auth, set key.
LLM_API_KEY=
# Set true only if your OpenAI-compatible endpoint does NOT require auth header
LLM_NO_AUTH=false
# Optional org/project headers for providers that support them
LLM_ORGANIZATION=
LLM_PROJECT=
# Optional task-specific model overrides
LLM_INTENT_MODEL=
LLM_TRANSCRIBE_MODEL=
LLM_LISTING_MODEL=
LLM_REPLY_MODEL=
LLM_CAMPAIGN_MODEL=
AI_MODEL_VERSION=2026.03.27
AI_TRAINING_MIN_CONFIDENCE=0.55
AI_AGENT_RUN_LIMIT=40
AI_AGENT_TRIGGER_SOURCE=scheduled_job
AI_AGENT_CREATED_BY=system_scheduler

# Founder-controlled AI CEO / Managing Director assistant.
# Keep direct sends off until founder approval workflows are fully trusted.
AI_CEO_OWNER_WHATSAPP_ENABLED=true
AI_CEO_OWNER_PHONES=
AI_CEO_OWNER_PHONE=
# Report-only WhatsApp recipients get scheduled AI CEO reports but cannot control the AI CEO.
AI_CEO_REPORT_WHATSAPP_RECIPIENTS=
AI_CEO_REPORT_WHATSAPP_RECIPIENT=
AI_CEO_OWNER_COMMAND_PREFIX=CEO
AI_CEO_EMAIL_SEND_MODE=draft
AI_CEO_OWNER_EMAIL=
AI_CEO_DELIVER_WHATSAPP=true
AI_CEO_DELIVER_EMAIL=true
AI_CEO_PHONE_TEST_OWNER=
AI_CEO_PHONE_TEST_COMMAND=CEO report
AI_CEO_PHONE_TEST_NON_OWNER=+15550001111
AI_CEO_PHONE_TEST_TIMEOUT_MS=15000
AI_CEO_INBOUND_EMAIL_ENABLED=false
TELEGRAM_BOT_TOKEN=
AI_CEO_TELEGRAM_OWNER_CHAT_IDS=
AI_CEO_TELEGRAM_WEBHOOK_SECRET=
AI_CEO_EMAIL_WEBHOOK_TOKEN=

# Outlook AI Email Agent.
# Use Microsoft Graph OAuth/app permissions. Do not enter raw mailbox passwords.
OUTLOOK_AI_AGENT_ENABLED=false
OUTLOOK_AI_DRAFT_ONLY=true
OUTLOOK_AI_REQUIRE_APPROVAL=true
OUTLOOK_AI_POLL_UNREAD_ONLY=true
OUTLOOK_AI_POLL_LIMIT=10
OUTLOOK_AI_MAILBOX=
OUTLOOK_AI_TENANT_ID=
OUTLOOK_AI_CLIENT_ID=
OUTLOOK_AI_CLIENT_SECRET=
OUTLOOK_AI_AUTO_SEND_CATEGORIES=

# External duplicate scanning for admin listing review.
# If no paid provider key is set, the backend uses a best-effort DuckDuckGo web search.
# Provider options: duckduckgo_lite | duckduckgo_html | bing | google_cse | serpapi
EXTERNAL_DUPLICATE_SCAN_PROVIDER=duckduckgo_lite
EXTERNAL_DUPLICATE_SCAN_DISABLED=false
EXTERNAL_DUPLICATE_SCAN_TIMEOUT_MS=10000
EXTERNAL_DUPLICATE_SCAN_RESULT_LIMIT=8
EXTERNAL_DUPLICATE_SCAN_CACHE_MINUTES=60
BING_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=

# Optional public map provider. When set, public listing maps use Google Maps;
# without it, the site falls back to OpenStreetMap/Leaflet.
GOOGLE_MAPS_API_KEY=

# OTP / SMS
OTP_ENABLED=true
# Admin/testing OTP override (works for both email and phone verify endpoints)
# Production defaults to disabled. Prefer the admin-only QA token endpoint
# (/api/admin/listing-submit-otp-override) with ADMIN_API_KEY for testing.
ADMIN_OTP_OVERRIDE_ENABLED=false
ADMIN_OTP_OVERRIDE_CODE=
# Optional: restrict override usage to specific contacts (comma separated emails/phones)
# Example: info@makaug.com,+256760112587
ADMIN_OTP_OVERRIDE_ALLOWLIST_STRICT=true
ADMIN_OTP_OVERRIDE_ALLOWLIST=
SMS_SENDER_ID=MakaUg
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_FROM_SMS=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Africa's Talking SMS (fallback when Twilio is not configured)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_BASE_URL=https://api.africastalking.com/version1/messaging

# Reverse geocoding
REVERSE_GEOCODE_BASE_URL=https://nominatim.openstreetmap.org/reverse
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=120
QUEUE_POLL_SECONDS=20

# Media storage adapters
# local | supabase | s3_presigned | s3
# Production recommendation: set MEDIA_STORAGE_PROVIDER=s3 and point S3_* at
# Cloudflare R2 or another S3-compatible object store. Do not use local storage
# for live WhatsApp/listing media on Render or any ephemeral app server.
MEDIA_STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=makaug-media
S3_PRESIGN_ENDPOINT=
S3_PRESIGN_TOKEN=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=makaug-prod-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Production data backup/archive.
# Uses S3-compatible storage; can use the same R2 account with a private bucket.
DATA_BACKUP_BUCKET=makaug-db-backups
DATA_BACKUP_PREFIX=makaug
DATA_BACKUP_LOCAL_PATHS=exports,reports,outputs,assets/sourced,assets/marketing
DATA_BACKUP_KEEP_LOCAL=false

# AI training/foundation exports. Defaults to DATA_BACKUP_BUCKET when omitted.
AI_EXPORT_BUCKET=makaug-admin-exports
AI_EXPORT_PREFIX=makaug/ai-exports
REQUIRE_CLOUD_AI_EXPORTS=true

# Google Analytics 4 (website telemetry)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=replace-with-ga-api-secret

# Listing submission OTP token (existing backend)
LISTING_OTP_EXPIRES_IN=30m
LISTING_OTP_JWT_SECRET=

# Email delivery
EMAIL_FROM=makaug.com <info@makaug.com>
# Microsoft Graph (recommended for GoDaddy/Microsoft 365 mailboxes where SMTP auth may be disabled)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=info@makaug.com

# Direct SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_AUTH=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Optional providers (fallback order: MS Graph -> SMTP -> Resend -> Webhook)
RESEND_API_KEY=
# Optional Resend-only sender override. Use a verified Resend domain/sender.
RESEND_FROM=
MAIL_WEBHOOK_URL=

# Support contacts
SUPPORT_EMAIL=info@makaug.com
LEAD_NOTIFICATION_EMAIL=info@makaug.com
SUPPORT_PHONE=+256760112587

# Optional demo seed users (keep disabled in production)
SEED_DEMO_USERS=false
SEED_DEMO_FINDER_PASSWORD=
SEED_DEMO_AGENT_PASSWORD=
